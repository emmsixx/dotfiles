custom-shader = shaders/cursor_smear.glsl

# Always start new windows at $HOME instead of inheriting the previous
# window's cwd (which can drift to `/` if Ghostty's first process ever
# launched with that as its working directory, e.g. via Dock/Spotlight).
working-directory = home

# Colors
foreground = #dddddd
background = #0c0d0f
cursor-color = #dddddd

# Text
font-size = 13

# Font
font-family = GoogleSansCode Nerd Font Mono

font-family = GoogleSansCode Nerd Font Mono
font-style = SemiBold
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = ExtraBold

# Background opacity
background-opacity = 0.8

# Padding
window-padding-x = 4
window-padding-y = 4

confirm-close-surface = false
