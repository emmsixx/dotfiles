.DS_Store
.secrets

# skills.sh generated artifacts (installed locally, never committed)
.agents/
skills/
.claude/skills/
.pi/*
!.pi/agent/
.pi/agent/*
!.pi/agent/settings.json
!.pi/agent/AGENTS.md
!.pi/agent/extensions/
!.pi/agent/extensions/**
.pi/agent/extensions/**/node_modules/
.pi/agent/extensions/**/bin/
.pi/agent/extensions/summaries/config.private.json
.pi/agent/extensions/summaries/config.private.json.*.tmp
!.pi/agent/skills/
!.pi/agent/skills/**
.codex/*
!.codex/
!.codex/config.toml
!.codex/rules/
!.codex/rules/default.rules

# DMS-generated niri config
.config/niri/dms/

# gh auth tokens
.config/gh/
.config/systemd/

# Runtime state from applications. ~/.config is kept as a real directory by
# the Go installer, so these must never be folded into the dotfiles checkout.
.config/astro/
.config/firecrawl-cli/
